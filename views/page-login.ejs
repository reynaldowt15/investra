<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
</head>

<body>
    <div class="container-fluid p-5 min-vh-100" style="background-color: #eee;">
        <div class="row d-flex justify-content-center align-items-center">
            <div class="col">
                <div class="card rounded-3 text-black">
                    <div class="row">
                        <div class="col">
                            <div class="card-body p-md-5 mx-md-4">
                                <div class="text-center">
                                    <h4 class="mt-1 mb-5 pb-1">Investra</h4>
                                </div>
                                <form accept="/login" method="post">
                                    <p>Please login to your Investra account</p>

                                    <div data-mdb-input-init class="form-outline mb-4">
                                        <label class="form-label" for="">Username</label>
                                        <input type="email" name="email" id="" class="form-control"
                                            placeholder="E-mail address" />
                                    </div>

                                    <div data-mdb-input-init class="form-outline mb-4">
                                        <label class="form-label" for="">Password</label>
                                        <input type="password" name="password" id="" class="form-control" />
                                    </div>

                                    <div class="text-center pt-1 mb-5 pb-1">
                                        <input type="submit" value="Log-in"
                                            class="btn btn-primary btn-block fa-lg gradient-custom-2 mb-3">
                                    </div>

                                    <div class="d-flex align-items-center justify-content-center pb-4">
                                        <p class="mb-0 me-2">Don't have an account?</p>
                                        <a href="/register" class="btn btn-outline-secondary">Create Account</a>
                                    </div>

                                </form>

                            </div>
                        </div>
                        <div class="col d-flex align-items-center bg-primary">
                            <div class="text-white px-3 py-4 p-md-5 mx-md-4">
                                <h4 class="mb-4">We are more than just a company</h4>
                                <p class="small mb-0">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed
                                    do eiusmod
                                    tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam,
                                    quis nostrud
                                    exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>

    <%- include('./partial/script') %>
</body>

</html>