<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
</head>

<body>
    <div class="container-fluid p-5 min-vh-100" style="background-color: #eee;">
        <div class="row d-flex justify-content-center align-items-center">
            <div class="col">
                <div class="card rounded-3 text-black">
                    <div class="row">
                        <div class="col">
                            <div class="card-body p-md-5 mx-md-4">
                                <div class="text-center">
                                    <h4 class="mt-1 mb-5 pb-1">Investra</h4>
                                </div>

                                <% if (error) { %>
                                    <div class="alert alert-danger" role="alert">
                                        <%= error %>
                                    </div>

                                    <% } %>

                                        <form action="/register" method="post">
                                            <p><strong>Create your account</strong></p>

                                            <div data-mdb-input-init class="form-outline mb-4">
                                                <label class="form-label" for="name">Name</label>
                                                <input type="text" name="name" id="name" class="form-control"
                                                    placeholder="Enter your full name" />
                                            </div>

                                            <div data-mdb-input-init class="form-outline mb-4">
                                                <label class="form-label" for="email">Email</label>
                                                <input type="email" name="email" id="email" class="form-control"
                                                    placeholder="E-mail address" />
                                            </div>

                                            <div data-mdb-input-init class="form-outline mb-4">
                                                <label class="form-label" for="password">Password</label>
                                                <input type="password" name="password" id="password"
                                                    class="form-control" placeholder="Create a password" />
                                            </div>

                                            <div data-mdb-input-init class="form-outline mb-4">
                                                <label class="form-label" for="confirmPassword">Confirm Password</label>
                                                <input type="password" name="confirmPassword" id="confirmPassword"
                                                    class="form-control" placeholder="Confirm your password" />
                                            </div>

                                            <div class="form-check mb-4">
                                                <input class="form-check-input" type="checkbox" name="agree" id="agree">
                                                <label class="form-check-label" for="agree" style="font-size: 12px;">
                                                    I agree to the Term & Conditions and Privacy Policy
                                                </label>

                                            </div>

                                            <div class="text-center pt-1 pb-1">
                                                <input type="submit" value="Create Account"
                                                    class="btn btn-primary btn-block fa-lg gradient-custom-2 mb-3">
                                            </div>

                                            <div class="text-center pt-1 text-muted">
                                                <p>Already have an account? <a href="/login">Login</a></p>
                                            </div>

                                        </form>



                            </div>
                        </div>
                        <div class="col d-flex align-items-center bg-primary">
                            <div class="text-white px-3 py-4 p-md-5 mx-md-4">
                                <h4 class="mb-4">
                                    Start Your Investment Journey
                                </h4>
                                <p class="small mb-4">
                                    Build and manage your investment portfolio in one simple and intuitive platform.
                                    Investra helps you keep your investments organized so you can focus on growing your
                                    financial future.
                                </p>

                                <p class="small"><strong>Create your account today and take the first step toward
                                        managing your portfolio with greater clarity and confidence.</strong></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>

    <%- include('./partial/script') %>
</body>

</html>