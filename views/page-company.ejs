<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
</head>

<body style="background-color: #ddd;">

    <div class="container-fluid p-5 min-vh-100" style="background-color: #ddd;">

        <div class="row d-flex justify-content-center">

            <div class="col-md-10">
                <div class="card rounded-3 text-black">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="card-body p-md-5">

                                <h3 class="mb-4">
                                    Companies
                                </h3>
                                <p class="text-muted mb-4">
                                    Explore companies available for investment.
                                </p>

                                <!-- COMPANY LIST -->

                                <% data.forEach(el=> { %>
                                    <div class="card mb-3 shadow-sm">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h5 class="mb-2">
                                                        <%= el.name %>
                                                    </h5>
                                                    <p class="mb-1">
                                                        <strong>Sector:</strong>
                                                        <%= el.sector %>
                                                    </p>
                                                    <p class="mb-0 text-muted">
                                                        <%= el.address %>
                                                    </p>
                                                </div>


                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>


                        <div class="col-md-4 d-flex align-items-center bg-primary rounded-end-3">
                            <div class="text-white px-4 py-5">
                                <h4 class="mb-4">
                                    Invest Smarter
                                </h4>
                                <p class="small mb-0">
                                    Discover companies and explore
                                    investment opportunities with Investra.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <%- include('./partial/script') %>

</body>

</html>