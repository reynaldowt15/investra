<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
</head>

<body>
    <!-- NAVBAR -->
    <%- include('./partial/navbar') %>

        <div class="container-fluid">
            <div class="row">
                <h3>
                    <%= dataPortofolioById.Companies[0].name %>, <%= dataPortofolioById.Companies[0].address %>
                </h3>
                <h3>
                    Sector: <%= dataPortofolioById.Companies[0].sector %>
                </h3>
                <form class="" action="/edit/<%= dataPortofolioById.id %>" method="post">
                    <div class="mb-3">
                        <label class="form-label">Value</label>
                        <input type="number" name="value" class="form-control" value="<%= dataPortofolioById.value %>">
                    </div>
                    <input type="submit" value="Edit" class="btn btn-outline-success">
                </form>
            </div>
        </div>

        <%- include('./partial/script') %>
</body>

</html>