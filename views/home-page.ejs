<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
</head>

<body>

    <!-- NAVBAR -->
    <%- include('./partial/navbar') %>

        <div class="container-fluid">

            <!-- SEARCH -->
            <div class="row px-4 pt-4">
                <form class="d-flex" method="get" accept="/home">
                    <input class="form-control me-2" type="search" name="search" placeholder="Search by Company Name"
                        aria-label="Search" />
                    <button class="btn btn-outline-secondary" type="submit">Search</button>
                </form>
            </div>


            <!-- TABLE -->
            <div class="row px-4 pt-2">
                <table class="table table-striped-columns table-bordered">
                    <thead class="text-center">
                        <tr>
                            <th>No.</th>
                            <th>Company Name</th>
                            <th>Sector</th>
                            <th>Value</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% dataPortofolio.forEach((el,i)=> { %>
                            <tr>
                                <td class="text-center">
                                    <%= i+1 %>.
                                </td>
                                <td>
                                    <%= el.Companies[0].name %>
                                </td>
                                <td>
                                    <%= el.Companies[0].sector %>
                                </td>
                                <td>
                                    <%= Helper.formatRupiah(el.value) %>
                                </td>
                                <td class="text-center">
                                    <a href=" /edit/<%=el.id %>" class="btn btn-success">Edit</a>
                                    <a href=" /delete/<%=el.id %>" class="btn btn-danger">Delete</a>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>



        </div>

        <%- include('./partial/script') %>
</body>

</html>