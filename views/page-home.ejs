<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
</head>

<body style="background-color: #ddd;">

    <!-- NAVBAR -->
    <%- include('./partial/navbar') %>

        <div class="container-fluid">

            <!-- ADD & SEARCH -->
            <div class="row px-4 pt-4">
                <h3><strong>Hello, <%= dataProfile.name %></strong></h3>
                <div class="col">
                    <a href="/add/portofolio" class="btn btn-outline-success ">Add
                        Portofolio</a>

                </div>

                <div class="col">
                    <form class="d-flex" method="get" accept="/home">
                        <input class="form-control me-2" type="search" name="search" placeholder="by Portofolio Name"
                            aria-label="Search" />
                        <button class="btn btn-outline-secondary" type="submit">Search</button>
                    </form>

                </div>
            </div>


            <!-- TABLE -->
            <div class="row px-4 pt-2">
                <table class="table table-striped-columns table-bordered">
                    <thead class="text-center">
                        <tr>
                            <th>No.</th>
                            <th>Portofolio Name</th>
                            <th>Number of Company</th>
                            <th>Value</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% dataPortofolio.forEach((el,i)=> { %>
                            <tr>
                                <td class="text-center">
                                    <%= i+1 %>.
                                </td>
                                <td>
                                    <%= el.name %>
                                </td>
                                <td>
                                    <%= el.Companies.length %>
                                </td>
                                <td>
                                    <% let totalValue=0 %>
                                        <% el.Companies.forEach(el=> { %>
                                            <% totalValue +=el.PortofolioCompany.value %>
                                                <% }) %>
                                                    <%= Helper.formatRupiah(totalValue) %>
                                </td>
                                <td class="text-center">
                                    <a href=" /edit/portofolio/<%=el.id %>" class="btn btn-success">Edit</a>
                                    <a href=" /delete/portofolio/<%=el.id %>" class="btn btn-danger">Delete</a>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <%- include('./partial/script') %>
</body>

</html>