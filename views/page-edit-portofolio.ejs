<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
</head>

<body style="background-color: #ddd;">
    <!-- NAVBAR -->
    <%- include('./partial/navbar') %>

        <div class="container-fluid p-5">
            <div class="row d-flex justify-content-center align-items-center">
                <div class="card rounded-3 text-black">
                    <div class="card-body p-md-5 mx-md-4">
                        <div class="text-center">
                            <h4 class="mt-1 mb-4 pb-1">Portofolio "<%= dataPortofolioById.name %>"</h4>
                        </div>

                        <a href="/add/portofolio/<%= dataPortofolioById.id %>/companies"
                            class="btn btn-outline-success mb-2">Add Company</a>

                        <div>
                            <% dataPortofolioById.Companies.forEach(el=> { %>
                                <div class="card mb-3 shadow-sm">
                                    <div class="card-body">
                                        <div class="row">
                                            <h5 class="mb-2">
                                                <%= el.formatCompany %>
                                            </h5>
                                            <p class="mb-4">
                                                <strong>Sector:</strong>
                                                <%= el.sector %>
                                            </p>
                                        </div>

                                        <div class="row justify-content-end align-items-center">
                                            <form
                                                action="/edit/portofolio/<%= dataPortofolioById.id %>/<%= el.PortofolioCompany.CompanyId%>"
                                                method="post">
                                                <div class="d-flex gap-2 justify-content-start">
                                                    <label class="form-label">
                                                        Invested money:
                                                    </label>
                                                    <input class="form-control w-auto" type="number" name="value"
                                                        value="<%= el.PortofolioCompany.value %>">
                                                    <input type="submit" class="btn btn-outline-success">
                                                    <a href="/delete/portofolio/<%= dataPortofolioById.id %>/<%= el.PortofolioCompany.CompanyId %>"
                                                        class="btn btn-outline-danger">Delete</a>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        <%- include('./partial/script') %>
</body>

</html>